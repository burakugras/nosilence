{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nosilence",
  "version": "0.1.7",
  "identifier": "app.nosilence.desktop",
  "build": {
    "frontendDist": "../client/dist-desktop",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm --prefix ../client run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../client run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nosilence",
        "width": 1000,
        "height": 780,
        "minWidth": 420,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: mediastream:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:4000 ws://127.0.0.1:4000 http://127.0.0.1:7880 ws://127.0.0.1:7880"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "End-to-end encrypted voice chat",
    "copyright": "Copyright (C) 2026 Nosilence contributors. AGPL-3.0-only.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBRTE3NzM3MkZGNkVBN0IKUldSNzZ2WXZOM2ZoeXV4dUV1emJLY05OODNsekRxS1poTmVCRGI4bmJJcW1TNFFIcjU4T2pZVHUK",
      "endpoints": [
        "https://github.com/burakugras/nosilence/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "nosilence"
        ]
      }
    }
  }
}
