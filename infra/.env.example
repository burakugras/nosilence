# Copy to .env and fill in. .env is never committed.
POSTGRES_USER=nosilence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nosilence_dev

LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long

# Optional: Sign in with Google. OAuth client of type "Web application" with redirect URI
# http://127.0.0.1:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
